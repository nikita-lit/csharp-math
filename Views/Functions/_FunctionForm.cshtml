@model FunctionInputModel

@{
    var showScopeSettings = ViewData.ModelState[nameof(Model.RangeFrom)]?.Errors.Count > 0
        || ViewData.ModelState[nameof(Model.RangeTo)]?.Errors.Count > 0;
    var saveLabel = Model.Id is null or 0 ? "Salvesta uurimine" : "Salvesta muudatused";
}

<section id="calculatorSection" class="calculator panel calculator-section" aria-labelledby="formulaHeading">
    <div class="section-heading">
        <div>
            <h2 id="formulaHeading">Sisesta funktsioon</h2>
            <p>Kirjuta valem või vali näide.</p>
        </div>
    </div>

    <div class="section-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div class="formula-entry-grid">
            <div>
                <div class="calculator-display-label">
                    <label asp-for="Formula">Funktsiooni valem</label>
                    <div class="calculator-cursor-controls">
                        <button type="button" data-action="left" aria-label="Kursor vasakule">
                            <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 12H5m7 7-7-7 7-7" />
                            </svg>
                        </button>
                        <button type="button" data-action="right" aria-label="Kursor paremale">
                            <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 12h14m-7-7 7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="calculator-screen">
                    <span class="calculator-prefix">f(x) =</span>
                    <input asp-for="Formula"
                           class="calculator-display"
                           inputmode="text"
                           autocomplete="off"
                           spellcheck="false"
                           maxlength="200"
                           aria-describedby="calculatorHint"
                           placeholder="x^2 - 6x + 9" />
                </div>

                <span asp-validation-for="Formula" class="text-danger small"></span>
                <div class="calculator-error text-danger small" role="alert" hidden></div>
                <span class="calculator-position visually-hidden" aria-live="polite"></span>
            </div>

            <div class="calculator-examples">
                <label for="calculatorExample">Näidisfunktsioon</label>
                <select id="calculatorExample" class="form-select">
                    <option value="">Vali näide…</option>
                    <option value="x^2-6x+9">x² − 6x + 9</option>
                    <option value="(-2+3x)(-2-3x)">(−2 + 3x)(−2 − 3x)</option>
                    <option value="(x^2-1)^3">(x² − 1)³</option>
                    <option value="(x^2-1)/(x^2-4)">(x² − 1)/(x² − 4)</option>
                    <option value="x^2/(x^2-4)">x²/(x² − 4)</option>
                    <option value="x*sqrt(1-x^2)">x√(1 − x²)</option>
                    <option value="(x-2)*sqrt(x)">(x − 2)√x</option>
                    <option value="sqrt(x^2-4x+8)">√(x² − 4x + 8)</option>
                </select>
            </div>
        </div>

        <p id="calculatorHint" class="input-hint">Kasuta muutujat x, sulge ja tehteid + − * / ^. Näiteks 2x või sqrt(x).</p>

        <div class="calculator-keypad">
            <div class="keypad-layout">
                <div class="calculator-common-functions" aria-label="Põhifunktsioonid">
                    <button type="button" class="calculator-key function-key" data-insert="^2">x²</button>
                    <button type="button" class="calculator-key function-key" data-template="^()" data-offset="2">xʸ</button>
                    <button type="button" class="calculator-key function-key" data-function="sqrt">√</button>
                    <button type="button" class="calculator-key function-key" data-function="ln">ln</button>
                    <button type="button" class="calculator-key function-key" data-function="sin">sin</button>
                    <button type="button" class="calculator-key function-key" data-function="cos">cos</button>
                    <button type="button" class="calculator-key function-key" data-insert="e">e</button>
                </div>

                <div class="calculator-keys" aria-label="Arvud ja tehted">
                    <button type="button" class="calculator-key clear-key" data-action="clear" aria-label="Puhasta valem">AC</button>
                    <button type="button" class="calculator-key utility-key" data-insert="(">(</button>
                    <button type="button" class="calculator-key utility-key" data-insert=")">)</button>
                    <button type="button" class="calculator-key utility-key" data-action="backspace" aria-label="Kustuta eelmine märk">⌫</button>
                    <button type="button" class="calculator-key number-key" data-insert="7">7</button>
                    <button type="button" class="calculator-key number-key" data-insert="8">8</button>
                    <button type="button" class="calculator-key number-key" data-insert="9">9</button>
                    <button type="button" class="calculator-key operator-key" data-insert="/">÷</button>
                    <button type="button" class="calculator-key number-key" data-insert="4">4</button>
                    <button type="button" class="calculator-key number-key" data-insert="5">5</button>
                    <button type="button" class="calculator-key number-key" data-insert="6">6</button>
                    <button type="button" class="calculator-key operator-key" data-insert="*">×</button>
                    <button type="button" class="calculator-key number-key" data-insert="1">1</button>
                    <button type="button" class="calculator-key number-key" data-insert="2">2</button>
                    <button type="button" class="calculator-key number-key" data-insert="3">3</button>
                    <button type="button" class="calculator-key operator-key" data-insert="-">−</button>
                    <button type="button" class="calculator-key number-key" data-insert="0">0</button>
                    <button type="button" class="calculator-key number-key" data-insert=".">.</button>
                    <button type="button" class="calculator-key variable-key" data-insert="x">x</button>
                    <button type="button" class="calculator-key operator-key" data-insert="+">+</button>
                </div>
            </div>
        </div>
    </div>

    <details class="scope-settings" open="@showScopeSettings">
        <summary>
            <span id="scopeSummary">Vahemiku seaded (valikuline)</span>
        </summary>
        <div class="scope-layout">
            <div class="scope-mode">
                <label class="form-check">
                    <input asp-for="RestrictDomain" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">Ainult valitud lõik</span>
                </label>
                <p id="scopeHint" class="input-hint">Funktsiooni uuritakse kogu määramispiirkonnas. x-vahemik määrab graafiku akna.</p>
            </div>

            <div class="calculator-range">
                <div>
                    <label asp-for="RangeFrom">x alates</label>
                    <input asp-for="RangeFrom"
                           class="form-control"
                           type="number"
                           step="any"
                           min="-1000"
                           max="1000"
                           aria-describedby="scopeHint"
                           required />
                    <span asp-validation-for="RangeFrom" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="RangeTo">x kuni</label>
                    <input asp-for="RangeTo"
                           class="form-control"
                           type="number"
                           step="any"
                           min="-1000"
                           max="1000"
                           aria-describedby="scopeHint"
                           required />
                    <span asp-validation-for="RangeTo" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </details>

    <div class="calculation-actions">
        <button type="button" class="button primary calculate-button" data-calculate>Arvuta</button>
        <button type="submit" class="button secondary save-button" disabled>@saveLabel</button>
    </div>
</section>
