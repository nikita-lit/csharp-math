@model FunctionAnalysis

<dl class="analysis-table">
    <div>
        <dt>1. Määramispiirkond ja muutumispiirkond</dt>
        <dd>
            X = <span data-property="domain">@Model.Domain</span><br />
            Y = <span data-property="valueRange">@Model.ValueRange</span>
        </dd>
    </div>
    <div>
        <dt>2. Paarsus</dt>
        <dd data-property="parity">@Model.Parity</dd>
    </div>
    <div>
        <dt>3. Nullkohad <span>f(x) = 0</span></dt>
        <dd data-property="zeros">@Model.Zeros</dd>
    </div>
    <div>
        <dt>4. Positiivsus- ja negatiivsuspiirkond</dt>
        <dd data-property="positivity">@Model.Positivity</dd>
    </div>
    <div>
        <dt>5. Esimene tuletis <span>f′(x)</span></dt>
        <dd class="math" data-property="derivative" data-latex="@Model.DerivativeLatex">@Model.Derivative</dd>
    </div>
    <div>
        <dt>6. Kriitilised punktid</dt>
        <dd data-property="criticalPoints">@Model.CriticalPoints</dd>
    </div>
    <div>
        <dt>7. Kasvamis- ja kahanemispiirkond</dt>
        <dd data-property="monotonicity">@Model.Monotonicity</dd>
    </div>
    <div>
        <dt>8. Ekstreemumid <span>max / min</span></dt>
        <dd data-property="extrema">@Model.Extrema</dd>
    </div>
    <div>
        <dt>9. Teine tuletis <span>f″(x)</span></dt>
        <dd class="math" data-property="secondDerivative" data-latex="@Model.SecondDerivativeLatex">@Model.SecondDerivative</dd>
    </div>
    <div>
        <dt>10. Kumerus ja nõgusus <span>∩ / ∪</span></dt>
        <dd data-property="concavity">@Model.Concavity</dd>
    </div>
    <div>
        <dt>11. Käänupunktid</dt>
        <dd data-property="inflectionPoints">@Model.InflectionPoints</dd>
    </div>
</dl>
