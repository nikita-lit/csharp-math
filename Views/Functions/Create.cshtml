@model FunctionInputModel
@{ ViewData["Title"] = "Kalkulaator"; }
<div class="page-heading"><h1 class="h2">Funktsiooni kalkulaator</h1><p>Koosta funktsioon nuppudega, vaata graafikut ja uuri lahenduskäiku.</p></div>
<div class="solver-layout"><div class="solver-input"><form asp-action="Create" method="post" class="analysis-form"><partial name="_FunctionForm" model="Model" /></form></div>
<partial name="_Workspace" model="@(new FunctionAnalysis { Formula = Model.Formula, RangeFrom = Model.RangeFrom, RangeTo = Model.RangeTo })" />
</div>
@section Scripts {
    <script src="~/js/formula-calculator.js" asp-append-version="true"></script>
    <script src="~/js/function-graph.js" asp-append-version="true"></script>
}
